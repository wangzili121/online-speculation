+    def run_orthrus_update(self, prompt, completion):
+        """Run one opted-in request replay after the worker releases its cache."""
+        if self._orthrus_online_learning_rate is None:
+            return
+        from blockspec.pypto_glm53_online_serving import ResidentDistillation
+
+        with self._state_lock:
+            width = self._api.VERIFY_QUERY_WIDTH
+            if len(completion) != width or len(prompt) + width > self._max_seq_len:
+                return
+            if self._requests or not self._free_slots:
+                return
+            if self._orthrus_learner is None:
+                self._orthrus_learner = ResidentDistillation(
+                    self, learning_rate=self._orthrus_online_learning_rate,
+                ).__enter__()
+            tokens = [*prompt, *completion]
+            learner = self._orthrus_learner
+            learner.step(tokens, len(prompt), self._free_slots[0], self._orthrus_mask_id)
+            logger.info("GLM_ORTHRUS_ONLINE_UPDATE step=%d", learner.mla_update.step_count)
