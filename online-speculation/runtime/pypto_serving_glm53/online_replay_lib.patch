+@pl.jit.inline
+def _save_orthrus_stream(stream: pl.Tensor, tape: pl.Tensor, start: pl.Scalar[pl.INDEX]):
+    """Save the six live residual rows used to replay one frozen sublayer."""
+    tile = 512
+    columns = D // tile
+    for job in pl.spmd(VERIFY_QUERY_WIDTH * HC_MULT * columns, name_hint="glm_orthrus_save_stream"):
+        row = job // (HC_MULT * columns)
+        channel = job // columns % HC_MULT
+        col = job % columns * tile
+        value = pl.slice(stream, [1, 1, tile], [row, channel, col])
+        tape = pl.assemble(tape, value, [start + row, channel, col])
+    return tape
+
+
+
+@pl.jit.inline
+def _save_orthrus_sublayer(output: pl.Tensor, tape: pl.Tensor, start: pl.Scalar[pl.INDEX]):
+    """Record the BF16 output consumed by mHC post-mix before workspace reuse."""
+    tile = 512
+    columns = D // tile
+    for job in pl.spmd(VERIFY_QUERY_WIDTH * columns, name_hint="glm_orthrus_save_sublayer"):
+        row = job // columns
+        col = job % columns * tile
+        value = pl.reshape(pl.slice(output, [1, tile], [row, col]), [1, 1, tile])
+        tape = pl.assemble(tape, value, [start + row, HC_MULT, col])
+    return tape
+
