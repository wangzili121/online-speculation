+
+    draft = SimpleNamespace(block=32, propose_batch=propose, student={})
+    session = PackedSession(None, 1, 384, (32, 16), draft=draft)
+    a = session.admit("a", 0, 131)
+    b = session.admit("b", 2, 137)
+    c = session.admit("c", 3, 353)
+    for handle, position, pages in ((a, 131, [2, 0]), (b, 137, [1, 2]), (c, 353, [0, 2, 1])):
+        record = session._lookup(handle)
+        record.committed = position
+        record.pages = pages
