+@pytest.mark.parametrize("phase", ["prefill", "decode"])
+def test_greedy_packed_dispatch_transfers_one_sample_packet_per_owner(phase):
+    from models.deepseek_v4_1_flash_a3.lm_head import SAMPLED_IDS_PAD
+    from models.deepseek_v4_1_flash_a3.packed import PackedSession
+
+    def cp(dst, src, size, *, worker_id):
+        readbacks.append((worker_id, size))
+        ctypes.memmove(dst, src, size)
+
+    def packed_value(tokens):
+        rows = torch.zeros(len(tokens), SAMPLED_IDS_PAD, dtype=torch.int32)
+        rows[:, 0] = torch.tensor(tokens)
+        return rows
+
+    packets = [packed_value((50, 52)), packed_value((63,))]
+    readbacks = []
+    ranks = [{} for _ in range(16)]
+    for owner, packet in zip((0, 4), packets, strict=True):
+        ranks[owner]["sampled_ids"] = SimpleNamespace(data_ptr=packet.data_ptr())
+    counts = {key: torch.zeros(16, dtype=torch.int32) for key in ("moe_num_tokens", "attention_num_tokens")}
+    graphs = SimpleNamespace(
+        ranks=[ranks, ranks], arguments=[{}, counts], names=[[], list(counts)],
+        programs=[None, None], config=None,
+        decode_inputs=SimpleNamespace(fields=[{}, {}, {}], upload=lambda *args: None),
+        runtime=SimpleNamespace(run=lambda *args, **kwargs: None, copy_from=cp),
+    )
+    session = PackedSession(graphs, 2, 256, (16, 16))
+    a, b, d = session.admit("a", 0, 1), session.admit("b", 0, 1), session.admit("d", 1, 1)
+    if phase == "decode":
+        for record in session.history.values():
+            record.committed = 1
+
+    def inputs(dp, group, index, capacity, *, sample_all):
+        assert not sample_all and index == int(phase == "decode") and capacity == 16
+        sampled = [(record.handle, row) for row, (record, _) in enumerate(group)]
+        return {}, sampled, len(group)
+
+    session._inputs = inputs
+    session._upload_prefill_group = lambda *args: None
+    run = session.prefill_greedy_batch if phase == "prefill" else session.decode_greedy_batch
+    assert run([(d, (40,)), (a, (30,)), (b, (39,))]) == {d: 63, a: 50, b: 52}
+    assert readbacks == [(0, packets[0].nbytes), (4, packets[1].nbytes)]
