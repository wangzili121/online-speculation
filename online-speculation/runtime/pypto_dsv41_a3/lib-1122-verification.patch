+def test_packed_speculative_wave_uses_each_requests_physical_pages():
+    from models.deepseek_v4_1_flash_a3.packed import PackedSession, VerifiedBatch
+
+    staged = []
+
+    def propose(rows, *, uploads, capture):
+        staged.extend(rows)
+        handle, count = capture
+        draft.student[handle] = ("device-logits", count)
+        return {row.owner: [11 if row.owner == 0 else 22] * row.candidates for row in rows}
+
+    draft = SimpleNamespace(block=32, propose_batch=propose, student={})
+    session = PackedSession(None, 1, 384, (32, 16), draft=draft)
+    a = session.admit("a", 0, 131)
+    b = session.admit("b", 2, 137)
+    c = session.admit("c", 3, 353)
+    for handle, position, pages in ((a, 131, [2, 0]), (b, 137, [1, 2]), (c, 353, [0, 2, 1])):
+        record = session._lookup(handle)
+        record.committed = position
+        record.pages = pages
+    verified = []
+
+    def verify(queries, *, teacher_limits):
+        assert teacher_limits == {b: 1}
+        verified.extend(queries)
+        return VerifiedBatch({a: (11, 54), b: (42,), c: (72,)}, {b: "teacher"})
+
+    session.verify_batch = verify
+    wave = session.speculate_batch([(a, 5), (b, 6), (c, 7)], teacher_limits={b: 1},
+                                   output_limits={a: 7, b: 2, c: 1}, student_capture=(b, 5))
+    assert [(r.history_key, r.pages, r.position, r.owner) for r in staged] == [
+        (a, (2, 0), 131, 0), (b, (1, 2), 137, 8),
+    ]
+    assert wave.proposals == {a: (11,) * 6, b: (22,), c: ()}
+    assert verified == [(a, (5, *(11,) * 6)), (b, (6, 22)), (c, (7,))]
+    assert wave.verified.emitted == {a: (11, 54), b: (42,), c: (72,)}
+    assert wave.verified.teacher_logits == {b: "teacher"}
+    assert wave.student == ("device-logits", 5)
