+def test_packed_verification_retains_only_committed_prefixes():
+    from models.deepseek_v4_1_flash_a3 import config as c
+    from models.deepseek_v4_1_flash_a3.host import prepare_prefill_inputs
+    from models.deepseek_v4_1_flash_a3.packed import PackedSession
+
+    slots, context, cap = 2, 256, 16
+    template = prepare_prefill_inputs(torch.empty(0, c.FLASH.hidden_size), cap, max_seq_len=context,
+                                      request_slots=slots)
+    history = {}
+
+    def lookup(ids, n, start, *, request_id):
+        history[request_id] = (*history.get(request_id, ())[:start], *ids)
+        return torch.zeros(2, n, 6144)
+
+    graphs = SimpleNamespace(
+        host_io={"idle_inputs": (template, {})},
+        weights=SimpleNamespace(lookup_rows=lambda ids: torch.zeros(len(ids), c.FLASH.hidden_size)),
+        engram=SimpleNamespace(lookup=lookup, history=history),
+    )
+    logits = torch.arange(6, dtype=torch.float32)[:, None].expand(-1, c.FLASH.vocab_size).contiguous()
+    reads = []
+
+    def read(dst, src, size, *, src_offset, worker_id):
+        reads.append((size, src_offset, worker_id))
+        ctypes.memmove(dst, src + src_offset, size)
+
+    graphs.ranks = [[], [{"logits": SimpleNamespace(data_ptr=logits.data_ptr())}]]
+    graphs.runtime = SimpleNamespace(copy_from=read)
+    session = PackedSession(graphs, slots, context, (cap, cap))
+    reject = session.admit("reject", 0, 126)
+    accept = session.admit("accept", 0, 2)
+    a, b = session.history["reject"], session.history["accept"]
+    a.committed, b.committed = 126, 2
+    history[reject], history[accept] = (1,) * 126, (2, 2)
+
+    def dispatch(groups, index, capacity, *, sample_all, greedy):
+        assert index == 1 and sample_all and greedy
+        values, sampled, count = session._inputs(0, groups[0], 0, capacity, sample_all=True)
+        assert count == 6
+        # Prefill formatting sorts by length. The selected positions retain their handle.
+        assert sampled == [(reject, 0), (reject, 1), (reject, 2), (reject, 3), (accept, 4), (accept, 5)]
+        assert values["state_block_table"].flatten().tolist() == [0, 1]
+        return {reject: [42, 13, 14, 15], accept: [24, 25]}
+
+    session._dispatch = dispatch
+    outcome = session.verify_batch([(accept, iter((23, 24))), (reject, (11, 12, 13, 14))],
+                                   teacher_limits={accept: 1, reject: 4})
+    result = outcome.emitted
+    assert list(result) == [accept, reject]
+    assert result == {accept: (24, 25), reject: (42,)}
+    assert (a.committed, b.committed) == (127, 4)
+    assert history[reject] == (*((1,) * 126), 11)
+    assert history[accept] == (2, 2, 23, 24)
+    assert outcome.teacher_logits[accept][:, 0].tolist() == [0.0]
+    assert outcome.teacher_logits[reject][:, 0].tolist() == [2.0]
+    assert reads == [(logits[0].nbytes, 0, 0), (logits[0].nbytes, 2 * logits[0].nbytes, 0)]
+    assert len(a.pages) == 2 and set(a.pages).isdisjoint(b.pages)
+    values, _, _ = session._inputs(0, [(a, [42])], 0, cap)
+    assert values["c1a_index_block_table"][0].tolist() == [a.pages[0], -1]
