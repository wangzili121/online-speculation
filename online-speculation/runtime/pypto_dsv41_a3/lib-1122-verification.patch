+        return differentiate(None)
+
+    optimizer = SimpleNamespace(update=update, failed=False)
+    session = PackedSession(None, 1, 256, (16, 32), draft=draft, draft_optimizer=optimizer)
+    handle = session.admit("a", 0, 1)
+    session.feedback[handle] = object()
+    session.draft_suffix_gradients = lambda *args, finished: finished or None
+    assert session.update_draft(handle, rate=1e-5) is None
+    assert handle in session.feedback and not released
+    assert session.update_draft(handle, rate=1e-5, finished=True)
+    assert handle not in session.feedback and released == [handle]
+    assert calls == [(1e-5, 1.), (1e-5, 1.)]
+    with pytest.raises(ValueError, match="live student capture"):
+        session.update_draft(handle, rate=1e-5)
+
