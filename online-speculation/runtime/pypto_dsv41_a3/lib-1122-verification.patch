+def test_staged_session_only_materializes_its_dp_and_collects_peer_samples():
+    from models.deepseek_v4_1_flash_a3 import config as c
+    from models.deepseek_v4_1_flash_a3.host import prepare_prefill_inputs
+    from models.deepseek_v4_1_flash_a3.packed import PackedSession
+    from models.deepseek_v4_1_flash_a3.utils import prepare_decode_inputs
+
+    template = prepare_prefill_inputs(torch.empty(0, c.FLASH.hidden_size), 16, max_seq_len=256)
+    lookups, uploads, steps, clears = [], [], [], []
+    def lookup(ids, n, start, *, request_id):
+        lookups.append((request_id.request_id, start, len(ids)))
+        return torch.zeros(2, n, 6144, dtype=torch.bfloat16)
+
+    def read(phase, dp, name, result):
+        assert dp == 2 and name == "sampled_ids"
+        result[:, 0] = 40 + phase
+
+    def exchange(stage, payload):
+        assert payload == {"2": [40 + int(stage.split("/")[1])]}
+        return {"0": [30 + int(stage.split("/")[1])]} if stage.endswith("/0/sampled") else {}
+
+    staged = SimpleNamespace(
+        templates=(template, prepare_decode_inputs(template)),
+        owns=lambda dp: dp in (2, 3),
+        stage=lambda phase, dp, rows, pool: uploads.append((phase, dp)),
+        prefill=SimpleNamespace(step=lambda _, e, d: steps.append((tuple(e), tuple(d)))),
+        decode=SimpleNamespace(step=lambda _, counts: steps.append(tuple(counts))),
+        read=read, link=SimpleNamespace(exchange=exchange),
+        clear=lambda dp, slot, pages, pool: clears.append((dp, slot, tuple(pages))),
+    )
+    graphs = SimpleNamespace(
+        staged_target=staged, host_io={"idle_inputs": staged.templates},
+        weights=SimpleNamespace(lookup_rows=lambda ids: torch.zeros(len(ids), c.FLASH.hidden_size)),
+        engram=SimpleNamespace(lookup=lookup, history={}),
+        rope_tables=(template["freqs_cos"], template["freqs_sin"]),
+    )
+    session = PackedSession(graphs, 1, 256, (16, 16))
+    a, b = session.admit("a", 0, 2), session.admit("b", 2, 1)
+    assert session.prefill_greedy_batch([(b, [5]), (a, [3, 4])]) == {a: 30, b: 40}
+    assert session.decode_greedy_batch([(b, [40])]) == {b: 41}
+    assert lookups == [("b", 0, 1), ("b", 1, 1)]
+    assert uploads == [(0, 2), (1, 2)]
+    assert steps == [((2, 0, 1, 0), (2, 0, 1, 0)), (0, 0, 1, 0)]
+    assert session.history["a"].pages == session.history["b"].pages == [0]
+    session.release(a)
+    session.release(b)
+    assert clears == [(2, 0, (0,))]
+    assert session.free_pages[0] == session.free_pages[2] == [1, 0]
