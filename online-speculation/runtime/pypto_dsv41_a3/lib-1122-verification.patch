+@pytest.mark.parametrize("capture_dp", (None, 0, 2, "resident"))
+def test_staged_rejection_hides_reserved_page_and_truncates_only_local_engram(capture_dp):
+    from models.deepseek_v4_1_flash_a3 import config as c
+    from models.deepseek_v4_1_flash_a3.host import prepare_prefill_inputs
+    from models.deepseek_v4_1_flash_a3.packed import PackedSession
+    from models.deepseek_v4_1_flash_a3.utils import prepare_decode_inputs
+    from blockspec.dsv41_packed_loss import ResidentPackedTeacherRows
+
+    template = prepare_prefill_inputs(torch.empty(0, c.FLASH.hidden_size), 16, max_seq_len=256)
+    history, page_tables, teacher_reads = {}, [], []
+    device_rows, freed = [], []
+    remote_samples = iter(([90, 91, 92],))
+
+    def lookup(ids, n, start, *, request_id):
+        history[request_id] = history[request_id][:start] + list(ids)
+        return torch.zeros(2, n, 6144, dtype=torch.bfloat16)
+
+    def read(phase, dp, name, output, *, row=0):
+        assert (phase, dp, row) == (1, 2, 0)
+        if name == "sampled_ids":
+            output[:, 0] = torch.tensor([99, 100, 101][:len(output)])
+        else:
+            teacher_reads.append((name, len(output)))
+            output.fill_(41 + len(teacher_reads))
+
+    def exchange(stage, payload):
+        return {"0": next(remote_samples)} if stage == "staged-target/1/0/sampled" else {}
+
+    def stage(phase, dp, values, pool):
+        assert (phase, dp) == (1, 2)
+        page_tables.append(values["c1a_index_block_table"][0].tolist())
+
+    staged = SimpleNamespace(
+        templates=(template, prepare_decode_inputs(template)),
+        owns=lambda dp: dp == 2,
+        stage=stage,
+        decode=SimpleNamespace(step=lambda *_: None),
+        read=read,
+        link=SimpleNamespace(exchange=exchange),
+    )
+    graphs = SimpleNamespace(
+        staged_target=staged, host_io={"idle_inputs": staged.templates},
+        weights=SimpleNamespace(lookup_rows=lambda ids: torch.zeros(len(ids), c.FLASH.hidden_size)),
+        engram=SimpleNamespace(lookup=lookup, history=history),
+        rope_tables=(template["freqs_cos"], template["freqs_sin"]),
+    )
+    session = PackedSession(graphs, 1, 256, (16, 16))
+    remote, local = session.admit("remote", 0, 126), session.admit("local", 2, 126)
+    for handle in (remote, local):
+        record = session.history[handle.request_id]
+        record.committed = 126
+        record.pages.append(session.free_pages[handle.dp].pop())
+    history[local] = [3] * 126
+
+    if capture_dp is None:
+        verified = session.verify_batch([(remote, (76, 56, 67)), (local, (77, 55, 66))],
+                                        teacher_limits={remote: 3, local: 3})
+        assert set(verified.teacher_logits) == {local}
+    else:
+        captured = remote if capture_dp == 0 else local
+        draft = SimpleNamespace(block=16, student={}, release_student=lambda _: None)
+        if capture_dp == "resident":
+            collector = SimpleNamespace(
+                loss=SimpleNamespace(rows=16, runtime=SimpleNamespace(free_tensor=lambda value, **_: freed.append(value))),
+                snapshot=lambda entry, first, count: device_rows.append((entry.rows, first, count)),
+            )
+            draft.teacher_copy = SimpleNamespace(
+                capture=lambda student: ResidentPackedTeacherRows(student, collector, "buffer", "flags"),
+            )
+
+        def propose(requests, *, uploads, capture):
+            assert capture == (captured, 2)
+            assert [(r.owner, r.position) for r in requests] == [(0, 126), (8, 126)]
+            if capture_dp != 0:
+                draft.student[local] = SimpleNamespace(position=126, rows=2, owner=0)
+            return {0: [56, 67], 8: [55, 66]}
+
+        draft.propose_batch = propose
+        session.draft = draft
+        wave = session.speculate_batch([(remote, 76), (local, 77)], width=3, student_capture=(captured, 2))
+        verified = wave.verified
+        assert wave.student is draft.student.get(captured)
+        assert not verified.teacher_logits
+        if capture_dp != 0:
+            assert session.feedback[local].remaining == 1
+            assert session.feedback[local].logits() is None
+        else:
+            assert not session.feedback
+    assert verified.emitted == {remote: (90,), local: (99,)}
+    assert teacher_reads == ([] if capture_dp in (0, "resident") else [("logits", 1)])
+    assert history == {local: [3] * 126 + [77]}
+    assert [session.history[handle.request_id].committed for handle in (remote, local)] == [127, 127]
+    assert session.history["local"].pages == [0, 1]
+    assert session.decode_greedy_batch([(local, (99,))]) == {local: 99}
+    if capture_dp == 2:
+        assert session.feedback[local].logits()[:, 0].tolist() == [42, 43]
+        assert teacher_reads == [("logits", 1), ("logits", 1)]
+    elif capture_dp == "resident":
+        assert device_rows == [(0, 0, 1), (1, 0, 1)]
+        assert len(session.feedback[local].logits()) == 2
+        assert not teacher_reads
+        session.release_student(local)
+        assert freed == ["buffer", "flags"]
+        assert not session.feedback
+    assert history[local][-2:] == [77, 99]
+    assert page_tables == [[0, 1], [0, -1]]
