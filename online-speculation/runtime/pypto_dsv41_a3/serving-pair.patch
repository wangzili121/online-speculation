diff --git a/models/deepseek_v41_a3/source.py b/models/deepseek_v41_a3/source.py
index 3c273bd..62d970a 100644
--- a/models/deepseek_v41_a3/source.py
+++ b/models/deepseek_v41_a3/source.py
@@ -22,9 +22,9 @@ import sys
 from dataclasses import dataclass
 from types import ModuleType

-A3_BASE_COMMIT = "2685c70292b17401b6e89fb62ff545915f60cd33"
-A3_COMMIT = "cabe2276de32e64fc8105ac1c80d2dae1604e6bf"
-A3_TREE = "78ff41f76fb5ade61df1dd9209a8f3a765404d6f"
