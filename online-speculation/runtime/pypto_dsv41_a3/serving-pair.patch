+    def verify_draft(self, batch, candidates):
+        """Run a greedy Orthrus round using externally supplied draft token IDs."""
+        self._check_open()
+        if batch.constraint_states or any(getattr(params, "forbidden_token_ids", ()) for params in batch.sampling_params):
+            raise ValueError("A3 Orthrus verifier requires unconstrained greedy requests")
+        proposed = []
+        for request_id, tokens in zip(batch.request_ids, candidates, strict=True):
+            # Leave room for the correction or bonus token supplied by the target.
+            mask = batch.stop_token_masks.get(request_id)
+            limit = min(ORTHRUS_BLOCK - 1, mask.remaining_tokens - 1) if mask else ORTHRUS_BLOCK - 1
+            tokens = tuple(tokens)[:max(0, limit)]
+            if mask:
+                stop = next((i for i, token in enumerate(tokens) if token in mask.stop_token_ids), len(tokens))
+                tokens = tokens[:stop]
+            if not tokens:
+                raise ValueError("Use ordinary Decode for requests without a draft to verify")
+            proposed.append(tokens)
+        chunks = self._batch(batch, "verify", candidates=proposed)
+        outputs = [None] * len(chunks)
+        try:
+            for wave in self.ledger.dispatches(chunks):
+                contract, order = self.ledger.input_contract(wave)
+                payloads = rank_metadata(self.source, self.cache_plan, self.ledger, wave)
+                handles = tuple(handle for handle, _ in order)
+                verifier_rows = self.session.execute("verify", contract, payloads, handles)
+                by_handle = {chunk.handle: chunk for chunk in wave}
+                accepted = []
+                for handle, logits in zip(handles, verifier_rows, strict=True):
+                    chunk = by_handle[handle]
+                    if (not isinstance(logits, torch.Tensor) or not logits.is_floating_point()
+                            or logits.shape != (len(chunk.tokens), self.vocabulary)
+                            or logits.device.type != "cpu" or not torch.isfinite(logits).all()):
+                        raise ValueError("A3 verifier must return one finite logit row per block position")
+                    target = logits.argmax(dim=-1).tolist()
+                    draft = chunk.tokens[1:]
+                    match = next((i for i, token in enumerate(draft) if token != target[i]), len(draft))
+                    outputs[chunk.output_row] = list(draft[:match]) + [target[match]]
+                    accepted.append(self.ledger.prepare_chunk(handle, chunk.tokens[:match + 1],
+                                                              chunk.start, chunk.output_row, "accept"))
+                accept_contract, accept_order = self.ledger.input_contract(accepted)
+                accept_payloads = rank_metadata(self.source, self.cache_plan, self.ledger, accepted)
+                self.session.execute("accept", accept_contract, accept_payloads,
+                                     tuple(handle for handle, _ in accept_order))
+                self.ledger.commit(accepted)
+                self.dispatch_count += 2
+        except Exception:
+            self.failed = True
+            try:
+                self.release_finished_requests(batch.request_ids)
+            except Exception:
+                logger.exception("A3 request cleanup failed after Orthrus verification")
+            raise
+        return DecodeResult(None, None, accepted_token_ids=outputs,
+                            num_draft_tokens=[len(tokens) for tokens in proposed])
+
     def release_finished_requests(self, request_ids):
         errors = []
