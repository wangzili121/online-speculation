@@ -93,7 +93,12 @@ class KernelSource:
         raise ValueError(f"Missing positive kernel capacity {module}.{name}")

     def network_capacity(self) -> int:
-        """Read the Prefill runtime's explicit capacity check, not a Decode case size."""
+        """Read the native service dispatch capacity."""
+        try:
+            return self.integer_constant("network", "SERVING_DISPATCH_CAPACITY")
+        except ValueError:
+            # Historical contract fixtures expose the capacity in the provider guard.
+            pass
         tree = ast.parse((self.directory / "network.py").read_text())
         function = next(node for node in tree.body if isinstance(node, ast.FunctionDef)
                         and node.name == "prepare_network_provider")
@@ -147,6 +152,8 @@ class KernelSource:
             "state_continuation_entry": "network.GenerationSession.advance",
             "decode_entry": "decode_network.DecodeNetwork.step(chunk=...)",
             "release_entry": "network.GenerationSession.release_request",
+            "draft_history_entry": ("network.GenerationSession.draft_history"
+                                    if "draft_history" in session else None),
             "generation_ready": ready, "supported_topology": topology,
             "context_limit": self.integer_constant("decode_network", "MAX_CONTEXT"),
             "prefill_dispatch_tokens_per_dp": self.network_capacity(),
