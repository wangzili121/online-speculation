+def test_orthrus_block_verifies_once_and_commits_only_accepted_prefixes(runner, plan, session, monkeypatch):
+    ids = ["all", "none", "some"]
+    partitions = [3, 0, 1]
+    for begin in range(0, 128, 16):
+        size = min(16, 127 - begin)
+        runner.run(prefill(plan, ids, partitions, tokens=[[5] * size] * 3, starts=[begin] * 3,
+                           prompt_lens=[127] * 3), "prefill")
+
+    original = session.execute
+    full_block = list(range(12, 43))
+    predictions = {"all": [*full_block, 43], "none": [90, 0, 0], "some": [12, 91, 0]}
+
+    def execute(phase, contract, payloads, handles):
+        result = original(phase, contract, payloads, handles)
+        if phase == "verify":
+            return tuple(torch.nn.functional.one_hot(torch.tensor(predictions[h.request_id]), num_classes=128)
+                         .float() for h in handles)
+        return result
+
+    monkeypatch.setattr(session, "execute", execute)
+    batch = DecodeBatch(ids, torch.tensor([[11]] * 3), None, torch.tensor([128] * 3, dtype=torch.int32),
+                        block_ids_by_group=[pages(plan)] * 3, cache_partitions=partitions)
+    result = runner.verify_draft(batch, [full_block, [12, 13], [12, 13]])
+    assert result.accepted_token_ids == [[*full_block, 43], [90], [12, 91]]
+    assert result.num_draft_tokens == [31, 2, 2]
+    assert [runner.ledger.requests[key].history[127:] for key in ids] == [[11, *full_block], [11], [11, 12]]
+    verification, committed = session.calls[-2:]
+    assert verification[0] == "verify" and committed[0] == "accept"
+    assert [engine["active"] for engine in verification[1]["DP_engines"]] == [3, 3, 0, 32]
+    assert [engine["active"] for engine in committed[1]["DP_engines"]] == [1, 2, 0, 32]
+
+
