+def resident_rank_devices(runtime, world, local_ranks=None):
+    """Bind local workers to global checkpoint rank IDs, without renumbering expert owners."""
+    ranks = tuple(range(world) if local_ranks is None else local_ranks)
+    if (not ranks or len(set(ranks)) != len(ranks)
+            or any(type(rank) is not int or not 0 <= rank < world for rank in ranks)
+            or len(ranks) != len(runtime.devices)):
+        raise ValueError("Static weight ranks must match the local resident devices")
+    return {rank: device for device, rank in enumerate(ranks)}
+
