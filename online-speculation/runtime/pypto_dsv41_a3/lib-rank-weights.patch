+def test_node_local_weight_bank_uses_global_expert_ids_and_local_buffers(monkeypatch):
+    from models.deepseek_v4_1_flash_a3 import resident_weights, weights
+
+    class Checkpoint:
+        def __init__(self, _):
+            operands = ("hc_ffn_fn", "hc_ffn_scale", "hc_ffn_base", "ffn_norm.weight",
+                        "ffn.gate.weight", "ffn.gate.bias", "ffn.gate.bias_vl")
+            self.index = {f"layers.{layer}.{name}": None for layer in range(40) for name in operands}
+            self.consumed, self.preparations = {}, {}
+            self.read_calls = self.file_open_calls = self.read_seconds = 0
+            self.selected_experts = []
+
+        def load(self, _):
+            self.read_calls += 1
+            return torch.arange(8).view(4, 2)
+
+        def expert(self, name, partitions=None):
+            if partitions is None:
+                self.selected_experts.append(int(name.rsplit(".", 1)[-1]))
+            return tuple(torch.zeros(1, 2) for _ in range(4))
+
+        def seal(self):
+            pass
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(weights, "ResidentCheckpointOperands", Checkpoint)
+    monkeypatch.setattr(weights, "resolve_layer_role", lambda layer: {"engram_slot": None})
+    monkeypatch.setattr(weights, "prepare_product_operands", lambda *args, **kwargs: {
+        "wo_a_grouped_prefill": torch.zeros(8, 1, 1), "wo_b": torch.zeros(8192, 1),
+    })
+    local = dict(dp=1, tp=2, ep=2)
+    world = dict(dp=4, tp=4, ep=16)
+    workers = [HostWorker(), HostWorker()]
+    with ResidentNetworkRuntime([0, 1], local, worker_factory=workers.__getitem__) as runtime:
+        runtime.load_rotation = lambda *args: (torch.zeros(32, 32), {})
+        bank = resident_weights.A3ResidentWeights("checkpoint", world, {}, runtime, local_ranks=(8, 9))
+        bank.preload_once()
+        assert bank.reader.selected_experts == list(range(192, 240)) * 40
+        assert tuple(bank.rank_devices.items()) == ((8, 0), (9, 1))
+        assert all(bank.prefill_handles[rank] for rank in (8, 9))
+        assert not any(bank.prefill_handles[rank] for rank in [*range(8), *range(10, 16)])
+        assert bank.decode.handles(9)["head.weight.kn"] is bank.prefill_handles[9]["head.weight.kn"]
+        assert bank.summary()["resident_global_ranks"] == [8, 9]
+        with pytest.raises(ValueError, match="does not belong"):
+            bank.decode.handles(2)
+        bank.close()
+
