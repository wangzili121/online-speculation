+def _read_speculative_vocab(logits_packets, records, case, executor, tp, draft=None):
+    """Materialize one host-side result per logical TP group."""
+    shards, packets = {}, {}
+    captured_dps = {owner[0] for owner in draft.capture[1]} if draft is not None and draft.capture else set()
+
+    def read_rank(rank):
+        active = len(records[rank]["positions"])
+        logits = logits_packets[rank][case]
+        if draft is not None and active >= ORTHRUS_BLOCK and rank // tp not in captured_dps:
+            packets[rank] = draft.attention.greedy_shard(rank, logits, active)
+        else:
+            shards[rank] = executor.resident.read_output(logits[:active], executor.rank_devices[rank]) if active else logits[:0]
+
+    executor.map_ranks(read_rank)
+    outputs, greedy = {}, {}
+    for leader in sorted(rank for rank in executor.rank_devices if rank % tp == 0):
+        ranks = range(leader, leader + tp)
+        if leader in packets:
+            from blockspec.pypto_dsv41_greedy import merge_greedy_shards
+            greedy[leader // tp] = merge_greedy_shards(
+                [packets[rank] for rank in ranks], logits_packets[leader][case].shape[1],
+            )
+        else:
+            merged = torch.cat([shards[rank] for rank in ranks], dim=-1)
+            for rank in ranks:
+                outputs[rank] = merged
+    return outputs, greedy
+
