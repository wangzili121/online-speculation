+def make_sp_reduce_widen(rows, hidden):
+    """Convert packed BF16 partials to FP32 before the TP reduction."""
+
+    @pl.jit
+    def reduce_widen(
+        value: pl.Tensor[[rows, hidden], pl.BF16],
+        output: pl.InOut[pl.Tensor[[rows, hidden], pl.FP32]],
+    ):
+        block_count = rows * (hidden // D_TILE)
+        for block_worker in pl.spmd(pl.min(block_count, SPMD_WORKER_LIMIT),
+                                    name_hint="prefill_sp_reduce_widen"):
+            for block in pl.range(block_worker, block_count, SPMD_WORKER_LIMIT):
+                row = block // (hidden // D_TILE)
+                column = block % (hidden // D_TILE) * D_TILE
+                tile = value[row : row + 1, column : column + D_TILE]
+                output[row : row + 1, column : column + D_TILE] = pl.cast(tile, pl.FP32)
+        return output
+
+    return reduce_widen
+
+
+def make_sp_reduce_narrow(rows, hidden):
+    """Round the deterministic FP32 TP sum once at the layer boundary."""
+
+    @pl.jit
+    def reduce_narrow(
+        value: pl.Tensor[[rows, hidden], pl.FP32],
+        output: pl.InOut[pl.Tensor[[rows, hidden], pl.BF16]],
+    ):
+        block_count = rows * (hidden // D_TILE)
+        for block_worker in pl.spmd(pl.min(block_count, SPMD_WORKER_LIMIT),
+                                    name_hint="prefill_sp_reduce_narrow"):
+            for block in pl.range(block_worker, block_count, SPMD_WORKER_LIMIT):
+                row = block // (hidden // D_TILE)
+                column = block % (hidden // D_TILE) * D_TILE
+                tile = value[row : row + 1, column : column + D_TILE]
+                output[row : row + 1, column : column + D_TILE] = pl.cast(tile, pl.BF16, mode="rint")
+        return output
+
+    return reduce_narrow
+
+
