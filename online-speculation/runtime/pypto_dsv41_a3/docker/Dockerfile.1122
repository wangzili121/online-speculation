ARG BASE_IMAGE=orthrus-dsv41-pypto:72a62d1-offline
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

ENV PYPTO_SRC=/opt/dsv41-1122/pypto \
    PYPTO_LIB_ROOT=/opt/dsv41-1122/pypto-lib \
    PYPTO_LIB_SRC=/opt/dsv41-1122/pypto-lib \
    PYPTO_MOTD_SHOWN=1
WORKDIR /opt/dsv41-1122
COPY online-speculation/runtime/pypto_dsv41_a3/runtime-release.patch ./
COPY online-speculation/runtime/pypto_dsv41_a3/pypto-1122-stacked-nz.patch ./
COPY online-speculation/runtime/pypto_dsv41_a3/docker/build-network.sh ./
COPY online-speculation/runtime/pypto_dsv41_a3/docker/cache-pto-isa.sh ./

RUN --mount=type=secret,id=pypto_proxy --mount=type=secret,id=pypto_ca --mount=type=secret,id=pypto_pypi \
    set -e; \
    source ./build-network.sh; \
    source /opt/pypto/bin/pypto-activate.sh; \
    if [[ -s /run/secrets/pypto_pypi ]]; then \
        UV_DEFAULT_INDEX="$(cat /run/secrets/pypto_pypi)"; export UV_DEFAULT_INDEX; \
    fi; \
    pypto_url=https://github.com/hw-native-sys/pypto.git; \
    if ! timeout 20s git ls-remote --exit-code "$pypto_url" HEAD >/dev/null; then \
        echo "The 1122 build container cannot reach GitHub. Set PYPTO_BUILD_PROXY and PYPTO_BUILD_CA as needed; a host-local proxy also requires PYPTO_BUILD_NETWORK=host." >&2; \
        exit 1; \
    fi; \
    git init pypto; \
    git -C pypto fetch --depth 1 "$pypto_url" 2e31e0c2a604c3c859c1268a937f97b0ee2d747f; \
    git -C pypto checkout --detach FETCH_HEAD; \
    git -C pypto apply "$PWD/pypto-1122-stacked-nz.patch"; \
    git -C pypto submodule update --init --recursive --depth 1; \
    test "$(git -C pypto/runtime rev-parse HEAD)" = a5349f42c71666bb8cacfb3759f34eeda1572beb; \
    git -C pypto/runtime apply "$PWD/runtime-release.patch"; \
    uv pip install --python /opt/pypto/venv/bin/python \
        -c "$PYPTO_SRC/build-constraints.txt" cmake ninja nanobind scikit-build-core; \
    bash "$PYPTO_SRC/docker/scripts/pypto-install-ptoas.sh"; \
    PYPTO_RUNTIME_BUILD_TARGETS=build_package_a2a3 PYPTO_BUILD_JOBS=4 \
        bash "$PYPTO_SRC/docker/scripts/pypto-build"

COPY online-speculation/runtime/pypto_dsv41_a3/lib-1122-verification.patch \
     online-speculation/runtime/pypto_dsv41_a3/moe-transport-1122-ipc.patch ./
RUN --mount=type=secret,id=pypto_proxy --mount=type=secret,id=pypto_ca set -e; \
    source ./build-network.sh; \
    git init pypto-lib; \
    git -C pypto-lib fetch --depth 1 https://github.com/Adelaide999/pypto-lib.git 949a18db40fca66f677fb041e98b32f824e7afb1; \
    git -C pypto-lib checkout --detach FETCH_HEAD; \
    git -C pypto-lib apply "$PWD/lib-1122-verification.patch"; \
    git -C pypto-lib fetch --depth 1 https://github.com/Adelaide999/pypto-lib.git e32726b7edb31ee17e398a0431c0272ebd545974; \
    git -C pypto-lib show FETCH_HEAD:models/deepseek_v4_1_flash_a3/moe_transport.py \
        > pypto-lib/models/deepseek_v4_1_flash_a3/moe_transport.py; \
    git -C pypto-lib apply "$PWD/moe-transport-1122-ipc.patch"; \
    cp "$PYPTO_SRC/docker/scripts/pypto-activate.sh" /opt/pypto/bin/pypto-activate.sh; \
    source /opt/pypto/bin/pypto-activate.sh; \
    bash ./cache-pto-isa.sh

COPY online-speculation/src/blockspec /opt/dsv41-1122/orthrus/blockspec
COPY online-speculation/scripts/run_dsv41_pypto_staged_target.py \
     online-speculation/scripts/prepare_dsv41_gsm8k.py \
     online-speculation/scripts/prepare_dsv41_pypto_staged_gsm8k.py \
     online-speculation/scripts/export_dsv41_orthrus_head.py \
     online-speculation/scripts/validate_dsv41_pypto_staged_teacher.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_history.py \
     online-speculation/scripts/validate_dsv41_pypto_ep_ipc.py \
     online-speculation/scripts/validate_dsv41_pypto_ep_hccl_boundary.py \
     online-speculation/scripts/validate_dsv41_pypto_ep_hccl_packets.py \
     online-speculation/scripts/validate_dsv41_pypto_ep_hccl_resident.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_decode_attention.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_decode_ffn.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_prefill.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_generation.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_adam.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_student.py \
     online-speculation/scripts/compile_dsv41_pypto_packed_draft.py \
     online-speculation/scripts/compile_dsv41_pypto_staged_adam.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_qkv.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_indexer.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_draft_tp.py \
     online-speculation/scripts/validate_dsv41_pypto_packed_layer.py \
     online-speculation/scripts/validate_dsv41_pypto_staged_draft_attention.py \
     online-speculation/scripts/validate_dsv41_pypto_staged_ffn_capture.py \
     online-speculation/scripts/validate_dsv41_pypto_staged_ep_vjp.py /opt/dsv41-1122/

ENV PYTHONPATH=/opt/dsv41-1122/pypto/python:/opt/dsv41-1122/pypto-lib:/opt/dsv41-1122/orthrus
ENTRYPOINT ["/bin/bash", "-lc", "source /opt/pypto/bin/pypto-activate.sh && exec python \"$@\"", "dsv41-1122"]
CMD ["validate_dsv41_pypto_packed_history.py", "--compile-only", "--swa"]
