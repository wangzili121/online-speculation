+def test_second_host_executor_maps_global_collective_and_cache_coordinates():
+    from models.deepseek_v4_1_flash_a3.network import NetworkExecutor
+
+    ranks = tuple(range(8, 16))
+    device_rows = tuple(range(8))
+    topology = dict(dp=4, tp=4, ep=16)
+    observed = []
+
+    def exchange(stage, packets, collective, group):
+        assert (stage, collective, group) == ("ep-test", "all_to_all", "ep")
+        assert [int(row["fresh"]["value"]) for row in packets] == list(ranks)
+        return packets, [dict(rank=rank, collective=collective) for rank in ranks]
+
+    def read(value, device):
+        observed.append(device)
+        return value.clone()
+
+    resident = SimpleNamespace(devices=device_rows, parameter_abis={}, read_control=read,
+                               map_ranks=lambda function: [function(device) for device in device_rows])
+    reports = [dict(communication=[]) for _ in range(16)]
+    executor = NetworkExecutor(topology, SimpleNamespace(local_ranks=ranks), None, None, reports,
+                               SimpleNamespace(stages={}), resident=resident,
+                               transport=SimpleNamespace(exchange=exchange))
+    assert executor.map_ranks(lambda rank: rank) == list(ranks)
+    rows = [{} for _ in range(8)] + [dict(fresh=torch.tensor([rank])) for rank in ranks]
+    output = executor.exchange("ep-test", rows, "all_to_all", "ep", host_control=True)
+    assert output[:8] == [{} for _ in range(8)] and observed == list(device_rows)
+    assert [int(row["fresh"]) for row in output[8:]] == list(ranks)
+    assert [row["communication"][0]["rank"] for row in reports[8:]] == list(ranks)
+
+
+def test_checkpoint_engram_mapping_gathers_rows_without_tmpfs(tmp_path):
+    import hashlib
+    from models.deepseek_v4_1_flash_a3.engram_host import SharedEngramArray
+
+    name = "layers.1.engram.embed.weight"
+    shard = tmp_path / "engram.safetensors"
+    values = torch.arange(32, dtype=torch.int8).view(8, 4)
+    save_file({name: values}, shard)
+    (tmp_path / "quant_model_weights.safetensors.index.json").write_text(
+        json.dumps(dict(weight_map={name: shard.name}))
+    )
+    digest = hashlib.sha256(values[2:7].numpy().tobytes()).hexdigest()
+    owner = SharedEngramArray(tmp_path, name, (2, 7), 4, "I8", digest, "test", checkpoint_mmap=True)
+    try:
+        assert owner.path is None and owner.receipt["storage"] == "checkpoint_mmap"
+        expected = torch.stack((values[2], values[6], torch.zeros(4, dtype=torch.int8)))
+        assert torch.equal(owner.gather(torch.tensor([2, 6, 7])), expected)
+    finally:
+        owner.close()
+    with pytest.raises(ValueError, match="frozen checkpoint"):
+        SharedEngramArray(tmp_path, name, (2, 7), 4, "I8", "wrong", "test", checkpoint_mmap=True)
