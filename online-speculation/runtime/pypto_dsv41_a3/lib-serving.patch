+    def verify_candidates(self, chunk, *, output, progress=None):
+        """Evaluate packed causal K32 candidates and restore authoritative state before returning logits."""
+        if self.closed or self.failed or self.provider.max_requests_per_partition is None:
+            raise RuntimeError("Verification needs a live serving generation session")
+        actual = chunk["inputs"]["input_contract"]
+        contract = chunk["contract"]
+        if contract["capacity"] != ORTHRUS_VERIFY_CAPACITY:
+            raise ValueError("Verification needs the wide native program")
+        requests = self._candidate_requests(chunk)
+        if not requests or any(not 1 < len(tokens) <= ORTHRUS_BLOCK for tokens in requests.values()):
+            raise ValueError("Verification requires the pending anchor plus 1..31 candidates")
+        for dp, slot, generation, start in requests:
+            _, committed = self.provider.request_history(dp, slot, generation)
+            if start != committed:
+                raise ValueError("Verification starts at the first uncommitted token")
+        self._verified_requests = None
+        previous = (self.epoch, self.contract, self.engram_contracts, self.program, self.provider.capacity)
+        world = self.contract["topology"]
+        metadata = chunk["cache"]["cache_ABI"]
+        if len(metadata) != world["ep"] or len(actual["DP_engines"]) != world["dp"]:
+            raise ValueError("Verification metadata must describe every resident rank")
+        try:
+            with ExitStack() as restore:
+                restore.enter_context(self.provider.provisional_dispatch())
+                for rank, payload in enumerate(metadata):
+                    if not actual["DP_engines"][rank // world["tp"]]["requests"]:
+                        continue
+                    intervals, history_pages = self.provider.verification_ranges(rank, payload)
+                    raw = self.provider.arenas[rank]["fresh"]
+                    ranges = [(raw[key], sorted(extents)) for key, extents in intervals.items()]
+                    restore.enter_context(self.runtime.preserve_cache_ranges(rank, ranges))
+                    for page in history_pages:
+                        history = self.provider.history.caches[rank]["fresh"][page * 128:(page + 1) * 128]
+                        restore.callback(history.copy_, history.clone())
+                result = self._advance(chunk, output=output, progress=progress, phase="verify")
+            self._verified_requests = requests
+            return result
+        except BaseException:
+            self.failed = True
+            raise
+        finally:
+            self.epoch, self.contract, self.engram_contracts, self.program, capacity = previous
+            self.provider.set_execution_capacity(capacity)
+
+    def commit_candidates(self, chunk, *, output, progress=None):
+        """Commit the anchor and accepted prefixes through the wide target forward."""
+        requests = self._candidate_requests(chunk)
