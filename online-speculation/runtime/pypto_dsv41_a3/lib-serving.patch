+            role = resolve_layer_role(layer)
+            for rank in provider.state_handles_for_layer(layer):
+                versions = rank["fresh"]["versions"]
+                for name, writes, owner in (("kv", role["kv_write"], role["kv_source"]),
+                        ("index", role["index_selection_write"], role["index_source"]),
+                        ("candidate", role["candidate_write"], role["candidate_source"])):
+                    if writes:
+                        versions[name] = (owner, *provider._chunk)
+            provider.observe_layer(layer, dict(hidden=None, pre_mix=None, states=None))
+
+    provider.begin_chunk(epoch=0, token_map_id="first")
+    complete_controls()
+    layout = provider.layouts[2]["fresh"]
+    handles = {}
+
+    def resident_handle(matrix, rank, *, readonly):
+        assert readonly
+        handle = object()
+        handles[handle] = (matrix, rank)
+        return handle
+
+    session = SimpleNamespace(closed=False, failed=False, contract={"topology": topology},
+                              provider=provider, _draft_plane_handles={},
