+            raise ValueError("Draft blocks require the pending anchor plus 31 MASK tokens")
+        tp = self.contract["topology"]["tp"]
+        histories = {
+            (rank, layer, (dp, slot, generation)): self.draft_history(
+                dp, slot, generation, rank=rank, layer=layer, anchor_position=anchor,
+            )
