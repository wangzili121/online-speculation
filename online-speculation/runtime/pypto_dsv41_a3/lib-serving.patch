+def test_request_pool_retains_inactive_history_rejects_aliases_and_retires_generations(tmp_path):
+    from copy import deepcopy
+    from dataclasses import asdict
+    from types import SimpleNamespace
+    from models.deepseek_v4_1_flash_a3.config import FLASH
+    from models.deepseek_v4_1_flash_a3.cache import resolve_layer_role
+    from models.deepseek_v4_1_flash_a3.network import GenerationSession
+    from models.deepseek_v4_1_flash_a3.state import NetworkCacheProvider
+
+    checkpoint = tmp_path / "checkpoint"
+    checkpoint.mkdir()
+    model = json.loads(json.dumps(dict(text_config=asdict(FLASH))))
+    (checkpoint / "config.json").write_text(json.dumps(model))
+    topology = dict(dp=4, tp=4, ep=16, pp=1, pcp=1, dcp=1)
+    cache = dict(cache_ABI=cache_templates({"token_map": torch.arange(128)}), engram_contracts={})
+    config = dict(model_config=model, topology=topology)
+    inputs = TokenChunkInputs(checkpoint=checkpoint, cache=cache, config=config,
+                              output=tmp_path / "prepared", context_capacity=256)
+
+    def controls(chunk, slot, generation, page_shift=0):
+        actual = deepcopy(chunk["inputs"]["input_contract"])
+        actual["DP_engines"][0]["requests"][0].update(request_slot=slot, generation=generation)
+        records = deepcopy(chunk["cache"]["cache_ABI"])
+        for record in records[:4]:
+            for group in record["groups"]:
+                group["block_table"] = group["block_table"].clone()
+                group["slot_mapping"] = group["slot_mapping"].clone()
+                group["block_table"][:, 1:] = -1
+                group["block_table"][:, :1] += page_shift
+                group["live_block_ids"] = group["block_table"][:, 0].tolist()
+                group["slot_mapping"][:, 0] += page_shift
+            for metadata in record["metadata"].values():
+                full = metadata["global_metadata"]
+                full["block_table"] = full["block_table"].clone()
+                full["slot_mapping"] = full["slot_mapping"].clone()
+                full["block_table"][:, 1:] = -1
+                full["block_table"][:, :1] += page_shift
+                slots = full["slot_mapping"][:, 0]
+                slots[slots >= 0] += page_shift
+        return actual, records
+
+    first = inputs.chunk([3])
+    actual, records = controls(first, 0, 1)
+    sources = [dict(rank=rank, payload_sha256="HOST", report_sha256="HOST") for rank in range(16)]
+    provider = NetworkCacheProvider({"fresh": records}, {"fresh": actual}, topology=topology,
+        model_config=model, capacity=16, scheduler_capacity=8192, allocation_id="host-pool",
+        sources_by_case={"fresh": sources}, geometry_only=True, max_requests_per_partition=2)
+
