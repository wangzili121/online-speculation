+def test_request_reset_clears_only_owned_mutable_ranges_and_preserves_static_uploads():
+    worker = HostWorker()
+
+    def fill(pointer, count, byte, rank):
+        assert rank == 0
+        ctypes.memset(pointer, byte, count)
+
+    with ResidentNetworkRuntime([0], dict(dp=1, tp=1, ep=1), worker_factory=lambda rank: worker,
+                                device_fill=fill) as runtime:
+        cache = torch.full((32,), 7, dtype=torch.uint8)
+        weight = torch.ones(8)
+        runtime.pin(cache, [0], readonly=False, name="raw/0/fresh/cache")
+        runtime.pin(weight, [0], readonly=True, name="weight")
+        uploads = runtime.stats["device_weight_upload_calls"]
+        identity = runtime.handle(cache, 0)
+        runtime.clear_ranges(cache, 0, [(4, 8)])
+        expected = [7] * 4 + [0] * 8 + [7] * 20
+        assert cache.tolist() == expected
+        assert worker.live[identity.data_ptr].tolist() == expected
+        assert runtime.handle(cache, 0).data_ptr == identity.data_ptr
+        assert runtime.stats["device_weight_upload_calls"] == uploads
+        assert runtime.stats["request_reset_bytes"] == 8
+        with pytest.raises(ValueError, match="exceeds"):
+            runtime.clear_ranges(cache, 0, [(30, 3)])
+        with pytest.raises(ValueError, match="static weights"):
+            runtime.clear_ranges(weight, 0, [(0, 4)])
+
