+                or any(not tokens or tokens != verified[key][:len(tokens)] for key, tokens in requests.items())):
+            raise ValueError("Commit must contain a prefix for every verified request generation")
+        self._verified_requests = None
+        return self._advance(chunk, output=output, progress=progress, phase="accept")
