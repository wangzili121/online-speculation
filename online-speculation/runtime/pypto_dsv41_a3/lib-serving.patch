+def test_verifier_preserves_only_bound_bytes_and_restores_on_error():
+    worker = HostWorker()
+    with ResidentNetworkRuntime([0], dict(dp=1, tp=1, ep=1), worker_factory=lambda rank: worker,
+                                device_copy=lambda dst, src, size, rank: ctypes.memmove(dst, src, size)) as runtime:
+        host = torch.arange(20, dtype=torch.uint8)
+        runtime.pin(host, [0], readonly=False, name="raw/0/fresh/cache")
+        handle = runtime.handle(host, 0)
+        device = worker.live[handle.data_ptr]
+        with pytest.raises(RuntimeError, match="fake failed verifier"):
+            with runtime.preserve_cache_ranges(0, [(host, [(1, 3), (10, 4)])]):
+                device[1:4].fill_(60)
+                device[10:14].fill_(70)
+                device[16] = 90
+                raise RuntimeError("fake failed verifier")
+        assert device[1:4].tolist() == [1, 2, 3]
+        assert device[10:14].tolist() == [10, 11, 12, 13]
+        assert int(device[16]) == 90
+        assert runtime.handle(host, 0).data_ptr == handle.data_ptr
+        assert runtime.stats["verify_backup_d2d_bytes"] == runtime.stats["verify_restore_d2d_bytes"] == 7
+        with pytest.raises(ValueError, match="overlap"):
+            with runtime.preserve_cache_ranges(0, [(host, [(1, 3), (3, 4)])]):
+                pytest.fail("overlapping ranges")
