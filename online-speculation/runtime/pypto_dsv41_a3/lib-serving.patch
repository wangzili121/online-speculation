+    def draft_history(self, dp_rank, request_slot, generation, *, rank, layer, anchor_position):
+        """Bind committed target pages to a draft reader while the session is idle.
+
+        The current anchor is pending and must be included by the draft block.
+        Handles alias target allocations and may be bound only to input parameters.
+        """
+        if self.closed or self.failed:
+            raise RuntimeError("A closed or failed generation session cannot bind draft history")
+        topology = self.contract["topology"]
+        tp = topology["tp"]
+        if not (0 <= dp_rank < topology["dp"] and dp_rank * tp <= rank < (dp_rank + 1) * tp):
+            raise ValueError("Draft rank must belong to the request's DP partition")
+        groups, committed = self.provider.request_history(dp_rank, request_slot, generation)
+        if anchor_position != committed:
+            raise ValueError("Draft anchor must immediately follow the committed target history")
+
+        role = resolve_layer_role(layer)
+        layout = self.provider.layouts[rank]["fresh"]
+        names = {"swa": f"model.layers.{layer}.self_attn.swa_cache"}
+        if role["kv_source"] is not None:
+            root = f"model.layers.{role['kv_source']}.self_attn."
+            names.update(long=root + "long_kv_cache", index=root + "indexer.k_cache")
+        planes = {}
+        for kind, name in names.items():
+            pages, = (group["pages"] for group in groups.values() if name in group["names"])
+            descriptors = layout["views"][name]
+            descriptors = descriptors if isinstance(descriptors, list) else [descriptors]
+            bindings = []
+            for descriptor in descriptors:
+                storage = descriptor["storage_key"]
+                shape = tuple(descriptor["shape"])
+                if any(not 0 < page < shape[0] for page in pages):
+                    raise ValueError("Draft history page escapes its target cache allocation")
+                dtype, width = DTYPES[descriptor["dtype"]], shape[-1]
+                stride = tuple(descriptor["stride"])
+                raw = self.provider.arenas[rank]["fresh"][storage]
+                matrix = raw.view(dtype).view(-1, width)
+                offset_bytes = descriptor["storage_offset_bytes"] - layout["raw"][storage]["storage_offset_bytes"]
+                row_bytes = width * matrix.element_size()
+                if stride[0] % width or offset_bytes % row_bytes or stride[1:] != (width, width, 1):
+                    raise ValueError("Draft history plane requires aligned contiguous rows")
+                key = rank, storage, dtype, width
+                if key not in self._draft_plane_handles:
+                    self._draft_plane_handles[key] = self.resident.handle(matrix, rank, readonly=True)
+                bindings.append(dict(handle=self._draft_plane_handles[key], pages=pages,
+                                     dtype=descriptor["dtype"], shape=shape, stride=stride,
+                                     stride_rows=stride[0] // width, offset_rows=offset_bytes // row_bytes))
+            planes[kind] = tuple(bindings)
+        return dict(role=role, committed_tokens=committed, planes=planes)
