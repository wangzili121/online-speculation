+    sources = [dict(rank=rank, payload_sha256="HOST", report_sha256="HOST") for rank in range(16)]
+    provider = NetworkCacheProvider({"fresh": records}, {"fresh": actual}, topology=topology,
+        model_config=model, capacity=16, scheduler_capacity=8192, allocation_id="host-pool",
+        sources_by_case={"fresh": sources}, geometry_only=True, max_requests_per_partition=2)
+
+    def complete_controls():
+        # Core publication double: no model computation or device acceptance.
