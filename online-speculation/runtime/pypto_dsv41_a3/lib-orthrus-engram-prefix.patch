+def verified_prefix_rows(verification, requests, lookback_depth):
+    """Find verifier rows with the same request ancestry and causal token prefix."""
+    if verification is None or not requests:
+        return None
+    candidates = {}
+    offset = 0
+    for request in verification["requests"]:
+        owner = request["request_slot"], request["generation"]
+        candidates[owner] = offset, request
+        offset += len(request["token_ids"])
+
+    rows = []
+    for request in requests:
+        owner = request["request_slot"], request["generation"]
+        if owner not in candidates:
+            return None
+        start, candidate = candidates[owner]
+        count = len(request["token_ids"])
+        if (request["initial_context_length"] != candidate["initial_context_length"]
+                or request["history_tokens"][-lookback_depth:] != candidate["history_tokens"][-lookback_depth:]
+                or request["token_ids"] != candidate["token_ids"][:count]):
+            return None
+        rows.extend(range(start, start + count))
+    return torch.tensor(rows, dtype=torch.long)


