-"""Orthrus 的临时任务池预算；不改变模型计算或运行时全局设置。"""
+"""Orthrus 的目标执行预算及 compact logits 坐标契约。"""
+
+
+def validate_target_contract(config, verify_rows=4):
+    if (config.speculative_tokens or config.prefix_cache or config.max_model_len != 512
+            or config.max_num_batched_tokens < config.max_num_seqs * verify_rows):
+        raise ValueError("Orthrus TP2 requires 512 context, native MTP/prefix cache off and capacity for verification rows")
+    threshold = config.long_prefill_token_threshold
+    if type(threshold) is not int or not 0 <= threshold <= config.max_model_len:
+        raise ValueError("prefill threshold must be zero or a positive limit within the context")
+
+
+def compact_teacher_row(input_count, batch_slot, source_row, count, retained=4):
+    """原生输出只保存每个请求的末四行，长 prefill 的绝对行号需先平移。"""
+    if (input_count < 1 or batch_slot < 0 or count < 1
+            or source_row < input_count - min(input_count, retained)
+            or source_row + count > input_count):
+        raise ValueError("teacher rows must lie within the retained native logits")
+    return retained * batch_slot + source_row - (input_count - min(input_count, retained))
 
 
